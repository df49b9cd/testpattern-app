{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "testpattern",
  "version": "0.1.0",
  "identifier": "dev.testpattern.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "testpattern",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#000000",
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' img: http://img.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' img: http://img.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "dmg"
    ],
    "category": "Video",
    "shortDescription": "IPTV player",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 the testpattern authors. Licensed under the GPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "libass",
          "libva",
          "pipewire-libs",
          "pulseaudio-libs",
          "alsa-lib",
          "uchardet",
          "lcms2",
          "libstdc++",
          "libdrm",
          "libglvnd-egl",
          "openssl-libs",
          "fribidi",
          "libunibreak"
        ],
        "files": {
          "/usr/share/licenses/testpattern/LICENSE": "../LICENSE",
          "/usr/share/licenses/testpattern/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md"
        }
      },
      "deb": {
        "depends": [
          "libasound2t64 (>= 1.0.27)",
          "libass9 (>= 1:0.15.0)",
          "libc6 (>= 2.39)",
          "libcairo2 (>= 1.10.0)",
          "libdbus-1-3 (>= 1.9.14)",
          "libdrm2 (>= 2.4.105)",
          "libegl1",
          "libgcc-s1 (>= 4.2)",
          "libgdk-pixbuf-2.0-0 (>= 2.36.9)",
          "libglib2.0-0t64 (>= 2.66.0)",
          "libgtk-3-0t64 (>= 3.21.5)",
          "libjavascriptcoregtk-4.1-0",
          "liblcms2-2 (>= 2.6)",
          "libpipewire-0.3-0t64 (>= 1.0.4)",
          "libpulse0 (>= 0.99.4)",
          "libsoup-3.0-0 (>= 3.0.3)",
          "libssl3t64 (>= 3.0.0)",
          "libstdc++6 (>= 11)",
          "libuchardet0 (>= 0.0.1)",
          "libva-drm2 (>= 1.1.0)",
          "libva2 (>= 2.2.0)",
          "libwebkit2gtk-4.1-0 (>= 2.41.90)",
          "libx11-6",
          "libxfixes3",
          "zlib1g (>= 1:1.2.0.2)"
        ],
        "files": {
          "/usr/share/doc/testpattern/copyright": "../packaging/debian/copyright",
          "/usr/share/doc/testpattern/LICENSE": "../LICENSE",
          "/usr/share/doc/testpattern/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "../packaging/macos/entitlements.plist",
      "files": {
        "Resources/LICENSE": "../LICENSE",
        "Resources/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md"
      }
    }
  }
}
