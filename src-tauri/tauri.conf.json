{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "testpattern",
  "version": "0.1.0",
  "identifier": "dev.testpattern.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "testpattern",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "appimage"
    ],
    "category": "Video",
    "shortDescription": "IPTV player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "libass",
          "libplacebo",
          "libva",
          "pipewire-libs",
          "pulseaudio-libs",
          "alsa-lib",
          "libdav1d",
          "uchardet",
          "lcms2",
          "libdisplay-info",
          "libdrm",
          "libglvnd-egl",
          "openssl-libs",
          "libxml2",
          "fribidi",
          "libunibreak"
        ]
      }
    }
  }
}
