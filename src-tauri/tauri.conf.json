{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "testpattern",
  "version": "0.1.0",
  "identifier": "dev.testpattern.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "testpattern",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' img: http://img.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' img: http://img.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "appimage"
    ],
    "category": "Video",
    "shortDescription": "IPTV player",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 the testpattern authors. Licensed under the GPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "libass",
          "libva",
          "pipewire-libs",
          "pulseaudio-libs",
          "alsa-lib",
          "uchardet",
          "lcms2",
          "libstdc++",
          "libdrm",
          "libglvnd-egl",
          "openssl-libs",
          "fribidi",
          "libunibreak"
        ],
        "files": {
          "/usr/share/licenses/testpattern/LICENSE": "../LICENSE",
          "/usr/share/licenses/testpattern/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md"
        }
      },
      "deb": {
        "files": {
          "/usr/share/doc/testpattern/copyright": "../packaging/debian/copyright",
          "/usr/share/doc/testpattern/LICENSE": "../LICENSE",
          "/usr/share/doc/testpattern/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md"
        }
      }
    }
  }
}
