# LF everywhere (shell scripts must stay runnable when checked out on Windows
# for the other-platform work, T-028); git detects text vs binary.
* text=auto eol=lf

# binary assets: never diff or normalize
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.webp binary

# lockfiles are generated: collapse them in diffs on code hosts
bun.lock linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
