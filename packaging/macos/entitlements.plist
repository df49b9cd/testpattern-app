<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WKWebView's JavaScriptCore needs JIT (its mmap PROT_EXEC pages); the
       hardened runtime forbids them unless this is set. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <!-- ad-hoc-signed dev builds load our own framework/dylib copies -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- outgoing connections: Xtream server, TMDB, M3U/XMLTV URLs -->
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
