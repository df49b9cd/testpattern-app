# Test IPTV accounts for the dev scripts (scripts/headless.sh seed,
# scripts/smoke.sh, scripts/dev-run.sh TP_DEV_AUTOPLAY). Copy to .env.local
# (gitignored) and fill in — never commit real values. Most Xtream accounts
# allow only ONE concurrent stream: the scripts play one stream at a time.
TP_XTREAM_SERVER=http://provider.example:8080
TP_XTREAM_USER_1=
TP_XTREAM_PASS_1=
# optional second account (manual tests that need two streams)
TP_XTREAM_USER_2=
TP_XTREAM_PASS_2=
# optional backup servers of the same provider, comma separated
TP_XTREAM_MIRRORS=
